# Configuracao opcional. Copie para .env se quiser mudar algum padrao.
# Por padrao o script roda LOCAL com Ollama e NAO precisa de nada aqui.

# --- Backend local (Ollama) ---
# OLLAMA_MODEL=qwen2.5vl:7b        # troque por qwen2.5vl:3b se faltar VRAM/quiser + rapido
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Rasterizacao ---
# PAGE_DPI=150                     # 130-150 local; suba p/ 180 se sobrar VRAM

# --- Backend nuvem (so se usar --backend gemini) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# SLEEP_BETWEEN_CALLS=0.5
